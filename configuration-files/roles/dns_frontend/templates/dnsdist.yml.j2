# == Caching ==

# https://dnsdist.org/guides/cache.html
# create a packet cache of at most 20'000'000 entries (~ 16GB),
# and apply it to the default pool
packet_caches:
  - name: "pc"
    size: 20000000
    max_ttl: 86400
    min_ttl: 0
    temporary_failure_ttl: 60
    stale_ttl: 60
    dont_age: false
pools:
  - name: ""
    packet_cache: "pc"
