# == Dynamic Blocks ==

# define a dynamic block rules group object, set a few limits and apply it
# see https://dnsdist.org/guides/dynblocks.html for more details.
# Dynamic blocking rules are active for monitoring purposes but do not block. Should our systems be exploited, the
# action can be configured to DNSAction.Drop.
dynamic_rules:
  - name: "Block client generating too many queries"
    rules:
      - type: "query-rate"
        rate: 250
        seconds: 10
        action_duration: 60
        comment: "Exceeded query rate"
        action: "Allow"
  - name: "Block client exceeding the configured bandwidth with their responses"
    rules:
      - type: "response-byte-rate"
        rate: 10000
        seconds: 10
        action_duration: 60
        comment: "Exceeded response BW rate"
        action: "Allow"
  - name: "Block client generating too many NXDOMAIN responses"
    rules:
      - type: "rcode-rate"
        rate: 20
        seconds: 10
        action_duration: 60
        comment: "Exceeded NXD rate"
        action: "Allow"
        rcode: "NXDOMAIN"
  - name: "Block client generating too many SERVFAIL responses"
    rules:
      - type: "rcode-rate"
        rate: 20
        seconds: 10
        action_duration: 60
        comment: "Exceeded ServFail rate"
        action: "Allow"
        rcode: "SERVFAIL"
  - name: "Block client generating too many PTR queries"
    rules:
      - type: "qtype-rate"
        rate: 20
        seconds: 10
        action_duration: 60
        comment: "Exceeded PTR rate"
        action: "Allow"
        qtype: "PTR"
  - name: "Block client generating too many NS queries"
    rules:
      - type: "qtype-rate"
        rate: 20
        seconds: 10
        action_duration: 60
        comment: "Exceeded NS rate"
        action: "Allow"
        qtype: "NS"
  - name: "Block client generating too many ANY queries"
    rules:
      - type: "qtype-rate"
        rate: 20
        seconds: 10
        action_duration: 60
        comment: "Exceeded ANY rate"
        action: "Allow"
        qtype: "ANY"

