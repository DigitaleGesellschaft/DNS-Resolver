---

# CAUTION: This file was generated automatically with Ansible. Manual changes will be overwritten.
#
# dnsdist configuration of the Digital Society Switzerland on their public DNS resolvers.
# see also https://www.digitale-gesellschaft.ch/dns/
#
#     DoH: https://dns.digitale-gesellschaft.ch/dns-query
#     DoT: dns.digitale-gesellschaft.ch:853
#
# In principle, we do not block name resolutions. However, if our service is abused to the harm of others, individual
# IP addresses or ranges or domain names are temporarily blocked to prevent the attack. Afterward, the blocks are
# lifted again.

# Accept requests from all over the Internet. Any IP v4 or v6 address is allowed to query.
acl:
  - "0.0.0.0/0"
  - "::/0"

# Listen for console connection with the given secret key
# https://dnsdist.org/guides/console.html
console:
  listen_address: "127.0.0.1:5199"
  key: "{{ dnsdist_control_interface_key }}"
  acl:
    - "127.0.0.0/8"

# Start the web server on port 8083, using a password
# https://dnsdist.org/guides/webserver.html
webserver:
  listen_addresses:
    - "127.0.0.1:8083"
  acl:
    - "127.0.0.0/8"
  password: "{{ dnsdist_webserver_password }}"
  api_key: "{{ dnsdist_webserver_api_key }}"

# Send statistics to PowerDNS metronome server https://metronome1.powerdns.com/
# https://dnsdist.org/guides/carbon.html
#carbon:
#  address: "37.252.122.50"
#  name: "unique-name"

# Listen for incoming DNS queries
binds:
  # accept DNS over TLS (DoT) queries on TCP/853
  # https://dnsdist.org/guides/dns-over-tls.html
{% for interf in vip_interfaces %}
  - listen_address: "{{ interf }}"
    protocol: "DoT"
    reuseport: true
    threads: {{ dnsdist_nof_thread_dot_per_ip }}
    tcp:
      fast_open_queue_size: 50
    tls:
      certificates:
        - certificate: "{{ cert_path }}live/{{ host_public }}.{{ domain }}.ecdsa/fullchain.pem"
          key: "{{ cert_path }}live/{{ host_public }}.{{ domain }}.ecdsa/privkey.pem"
      ciphers: "DEFAULT:-CBC"
      prefer_server_ciphers: true
      minimum_version: "tls1.2"
{% endfor %}

{% for interf in vip_interfaces %}
  # accept DNS over HTTPS (DoH) queries on TCP/443
  # https://dnsdist.org/guides/dns-over-https.html
  - listen_address: "{{ interf }}"
    protocol: "DoH"
    reuseport: true
    threads: {{ dnsdist_nof_thread_doh_per_ip }}
    tcp:
      fast_open_queue_size: 50
    tls:
      certificates:
        - certificate: "{{ cert_path }}live/{{ host_public }}.{{ domain }}.ecdsa/fullchain.pem"
          key: "{{ cert_path }}live/{{ host_public }}.{{ domain }}.ecdsa/privkey.pem"
      ciphers: "DEFAULT:-CBC"
      prefer_server_ciphers: true
      minimum_version: "tls1.2"
    doh:
      paths:
        - "/"
        - "/dns-query"
      responses_map:
        - expression: "^/$"
          status: 302
          content: "https://{{ name_intern }}.{{ domain }}/"
{% endfor %}

# accept DNS over QUIC (DoQ) queries on UDP/853
# https://www.dnsdist.org/guides/dns-over-quic.html
#  - listen_address: "127.0.0.1:853"
#    protocol: "DoQ"
#    tls:
#      certificates:
#        - certificate: "server.crt"
#          key: "server.key"
# accept DNS over HTTP/3 (DoH3) queries on UDP/443
# https://www.dnsdist.org/guides/dns-over-http3.html
#  - listen_address: "127.0.0.1:443"
#    protocol: "DoH3"
#    tls:
#      certificates:
#        - certificate: "server.crt"
#          key: "server.key"

# define downstream servers, aka backends
# https://dnsdist.org/guides/downstreams.html
# https://dnsdist.org/guides/serverpools.html
# https://dnsdist.org/guides/serverselection.html
backends:
{% for i in range(dnsdist_nof_thread_upstream) %}
  - name: "backend-{{ i }}"
    address: "{{ ip_localhost }}"
    protocol: "Do53"
{% endfor %}

